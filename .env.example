# ============================================
# KYRUS ERP - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- Geral ---
PROJECT_NAME=Kyrus ERP
ENVIRONMENT=production

# --- Segurança ---
# Gere uma chave aleatória: openssl rand -hex 32
SECRET_KEY=sua-chave-secreta-aleatoria-aqui-min-32-caracteres

# --- Token JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS (URLs autorizadas - separadas por vírgula) ---
# Exemplo: http://localhost:3000,https://meuprojeto.com
BACKEND_CORS_ORIGINS=*

# --- Banco de Dados PostgreSQL ---
POSTGRES_SERVER=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=kyrus_user
POSTGRES_PASSWORD=kyrus_pass
POSTGRES_DB=kyrus_db

# --- AWS S3 (Opcional - deixe vazio se não usar) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=

# --- Frontend ---
# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# --- IA Assistente (Opcional) ---
# Provedor da IA: gemini ou openai
AI_PROVIDER=gemini
# Timeout em segundos para chamadas ao provedor
AI_TIMEOUT_SECONDS=30

# Gemini (recomendado)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (opcional/compatibilidade)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

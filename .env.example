# ============================================
# KYRUS ERP - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- Geral ---
PROJECT_NAME=Kyrus ERP
ENVIRONMENT=production

# --- Segurança ---
# Gere uma chave aleatória: openssl rand -hex 32
SECRET_KEY=sua-chave-secreta-aleatoria-aqui-min-32-caracteres
API_KEY_PEPPER=seu-pepper-secreto-aleatorio-aqui-min-32-caracteres

# --- Token JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# --- CORS (URLs autorizadas - separadas por vírgula) ---
# Exemplo: http://localhost:3000,https://meuprojeto.com
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Banco de Dados PostgreSQL (APP PRÓPRIO) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5444
POSTGRES_USER=kyrus_user
POSTGRES_PASSWORD=kyrus_pass
POSTGRES_DB=kyrus_erp
POSTGRES_ALLOWED_CIDRS=

# --- Migração única do banco legado para o banco próprio ---
COPY_LEGACY_DATABASE=0
DROP_UNUSED_TABLES=0
LEGACY_POSTGRES_SERVER=postgresql
LEGACY_POSTGRES_PORT=5432
LEGACY_POSTGRES_USER=postgres
LEGACY_POSTGRES_PASSWORD=postgres
LEGACY_POSTGRES_DB=kyrus

# --- AWS S3 (Opcional - deixe vazio se não usar) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=

# --- Frontend ---
# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# --- IA Assistente (Opcional) ---
# Provedor da IA: gemini ou openai
AI_PROVIDER=gemini
# Timeout em segundos para chamadas ao provedor
AI_TIMEOUT_SECONDS=30

# Gemini (recomendado)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (opcional/compatibilidade)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
